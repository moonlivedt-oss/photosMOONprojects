@echo off
rem Перетащите на этот файл лист с несколькими рисунками (можно несколько листов).
rem Результат - папка "<лист> - нарезка" рядом, картинки 256x256 webp без фона.
chcp 65001 >nul
set PYTHONIOENCODING=utf-8
if "%~1"=="" (echo Перетащите картинку-лист на этот файл. & pause & exit /b)
py -3.14 "%~dp0картинки.py" нарезать %*
echo.
pause
